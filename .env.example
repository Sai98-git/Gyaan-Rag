# =============================================================
# Gyaan RAG — Environment Variables
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
#
#   cp .env.example .env    (macOS/Linux)
#   copy .env.example .env  (Windows)
#
# =============================================================

# --- Dataset Configuration ---
DATASET_NAME=ai4bharat/MSMARCO-XI
CORPUS_MODE=sample
MAX_RECORDS=25000
DATA_LANGUAGE=hi
DATA_SPLIT=train

# --- Chunking Configuration ---
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=1000

# --- Retrieval Configuration ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# --- Generation Configuration ---
# Set to "sarvam" for real LLM answers (requires SARVAM_API_KEY below).
# Set to "mock" for offline development without an API key.
GENERATION_PROVIDER=mock

# Sarvam AI API Key — required when GENERATION_PROVIDER=sarvam
# Get your key at: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b

# --- Grounding Guard ---
# Retrieval similarity threshold below which the system abstains.
# Calibrated value: 0.78 (accepts ~95% positives, filters clear out-of-domain)
MIN_RETRIEVAL_SCORE=0.78

# --- Voice / Speech-to-Text Configuration ---
# STT provider: "sarvam" (default for Indic) or "elevenlabs"
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3
STT_TIMEOUT_SECONDS=15.0

# ElevenLabs API Key — optional fallback when STT_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Hugging Face (optional) ---
# Set to enable authenticated downloads with higher rate limits.
# Required for downloading MSMARCO-XI dataset shards.
# HF_TOKEN=your_hugging_face_token_here
