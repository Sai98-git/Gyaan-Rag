{
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/components/:path*", "destination": "/frontend/components/:path*" },
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/app.js", "destination": "/frontend/app.js" },
    { "source": "/favicon.ico", "destination": "/frontend/assets/favicon.ico" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ]
}
